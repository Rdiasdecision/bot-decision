MARITACA_API_KEY=sua-chave-aqui
MARITACA_MODEL=sabiazinho-4
MARITACA_BASE_URL=https://chat.maritaca.ai/api

# Use exclusivamente um usuario PostgreSQL read-only.
DB_HOST=seu-servidor.postgres.database.azure.com
DB_PORT=5432
DB_NAME=seu_banco
DB_USER=chatbot_reader
DB_PASSWORD=troque-esta-senha
DB_SSLMODE=require

# Alternativa opcional: se definida, DATABASE_URL tem prioridade sobre DB_*.
# DATABASE_URL=postgresql://chatbot_reader:senha@host:5432/seu_banco?sslmode=require

# Lista explicita e separada por virgulas. Informe schema.view.
ALLOWED_VIEWS=public.vw_vendas
MAX_ROWS=100
STATEMENT_TIMEOUT_MS=10000
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
SHOW_SQL=true
